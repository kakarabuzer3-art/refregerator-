# Copy to .env.local for local use, and set the same names in your host (Vercel/Netlify) settings.

# The public address of the site (no trailing slash). Used for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.ie

# Keep "false" until the placeholder content is replaced. Set to "true" at launch so Google can index the site.
NEXT_PUBLIC_ALLOW_INDEXING=false
